/* tTorrent's look, on Kitab's model. A template: DoseThemeSource replaces
   @token@ with the theme's colours (themes/*.json, accent adjusted for
   contrast) and the density's sizes. One surface, hairlines between panes,
   colour only for the accent and states. */

* {
    font-family: "Instrument Sans", "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: @font@px;
}

QMainWindow, QDialog, QDockWidget { background: @bg@; color: @text@; }
QWidget { color: @text@; }

QToolBar {
    background: @bg@;
    border: none;
    border-bottom: 1px solid @line@;
    padding: @toolPad@px 10px;
    spacing: 4px;
}
QToolBar::separator { width: 1px; background: @line@; margin: 7px 6px; }
QToolButton {
    border: 1px solid transparent;
    border-radius: @radius@px;
    padding: @toolPad@px;
    color: @text@;
}
QToolBar QToolButton { padding: 4px; min-height: 22px; max-height: 30px; }
QToolBar QLineEdit { padding: 0 10px; min-height: 22px; max-height: 30px; }
QToolButton:hover { background: @hover@; }
QToolButton:pressed { background: @panel@; }
QToolButton:checked { background: @select@; }

QMenuBar { background: transparent; padding: 2px 4px; spacing: 2px; }
QMenuBar::item { padding: @padV@px 11px; border-radius: 8px; background: transparent; color: @muted@; }
QMenuBar::item:selected { background: @hover@; color: @text@; }
QMenuBar::item:pressed { background: @select@; color: @text@; }
/* Menus: room for icons on the left and shortcuts on the right, so nothing
   is clipped; rounded 14 px with 10 px items. */
/* Menus: compact rows like the system's and a visible hover. (No graphics
   shadow: on Windows it stops translucent pop-ups repainting.) */
QMenu {
    background: @raised@;
    border: 1px solid @line@;
    border-top-color: @edgeHi@;
    border-radius: 10px;
    padding: 4px;
    min-width: 200px;
}
QMenu::item {
    padding: 5px 20px 5px 10px;
    margin: 0;
    border-radius: 6px;
}
QMenu[doseDense="true"]::item { padding: 3px 20px 3px 10px; }
QMenu::item:selected { background: @menuHover@; color: @text@; }
QMenu::item:disabled { color: @ring@; }
QMenu::separator { height: 1px; background: @line@; margin: 4px 8px; }
QMenu::icon { padding-left: 10px; }
QMenu::indicator { width: 14px; height: 14px; left: 10px; }
QMenu::right-arrow { image: url(@chevronRight@); width: 12px; height: 12px; right: 12px; }

QTreeView, QTableView, QListView, QTreeWidget, QListWidget {
    background: @bg@;
    alternate-background-color: @bg@;
    border: none;
    selection-background-color: @select@;
    selection-color: @text@;
    outline: 0;
}
QTreeView::item, QTableView::item, QListView::item {
    padding: @rowPad@px 4px;
    border-bottom: 1px solid @rowRule@;
}
QTreeView::item:hover, QListView::item:hover { background: @hover@; }
QTreeView::item:selected, QTableView::item:selected, QListView::item:selected {
    background: @select@;
    color: @text@;
}

QHeaderView { background: @bg@; border: none; }
QHeaderView::section {
    background: @bg@;
    color: @faint@;
    border: none;
    border-bottom: 1px solid @line@;
    border-right: 1px solid @line@;
    padding: @padV@px 10px;
    font-weight: 500;
    font-size: @fontSmall@px;
}
QHeaderView::section:last, QHeaderView::section:only-one { border-right: none; }
QHeaderView::section:hover { background: @hover@; }
QHeaderView::section:first { padding-left: 12px; }
QHeaderView::up-arrow { image: url(@chevronUp@); width: 10px; height: 10px; subcontrol-position: center right; right: 4px; }
QHeaderView::down-arrow { image: url(@chevronDown@); width: 10px; height: 10px; subcontrol-position: center right; right: 4px; }
QHeaderView::section:hover { color: @text@; }

QTabWidget::pane { border: none; border-top: 1px solid @line@; }
QTabBar::tab {
    background: transparent;
    color: @muted@;
    padding: @padV@px @padH@px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover { color: @text@; }
QTabBar::tab:selected { color: @text@; border-bottom: 2px solid @accent@; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateTimeEdit, QPlainTextEdit, QTextEdit, QKeySequenceEdit {
    background: @well@;
    border: 1px solid @line@;
    border-top-color: @wellEdge@;
    border-radius: @radius@px;
    padding: @padV@px @padH@px;
    color: @text@;
    selection-background-color: @select@;
    selection-color: @text@;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid @accent@;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { color: @ring@; }
QComboBox { padding-right: 30px; min-width: 70px; combobox-popup: 0; }
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover { border-color: @ring@; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: center right; border: none; width: 26px; }
QComboBox::down-arrow { image: url(@chevronDown@); width: 14px; height: 14px; }
QComboBox::down-arrow:on { image: url(@chevronUp@); }
QComboBox QAbstractItemView {
    background: @raised@;
    border: 1px solid @line@;
    border-radius: 12px;
    selection-background-color: @select@;
    selection-color: @text@;
    padding: 4px;
    outline: 0;
}
QComboBox QAbstractItemView::item { min-height: 30px; padding: 0 10px; margin: 1px 0; border-radius: 8px; border: none; }
QComboBox QAbstractItemView::item:hover { background: @hover@; }
QComboBoxPrivateContainer { background: transparent; border: none; }

QSpinBox, QDoubleSpinBox, QDateTimeEdit { padding-right: 24px; }
QSpinBox::up-button, QDoubleSpinBox::up-button, QDateTimeEdit::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button, QDateTimeEdit::down-button {
    subcontrol-origin: border; width: 22px; border: none; background: transparent;
}
QSpinBox::up-button, QDoubleSpinBox::up-button, QDateTimeEdit::up-button { subcontrol-position: top right; margin: 2px 2px 0 0; }
QSpinBox::down-button, QDoubleSpinBox::down-button, QDateTimeEdit::down-button { subcontrol-position: bottom right; margin: 0 2px 2px 0; }
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background: @hover@; border-radius: 4px; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow, QDateTimeEdit::up-arrow { image: url(@chevronUp@); width: 11px; height: 11px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow, QDateTimeEdit::down-arrow { image: url(@chevronDown@); width: 11px; height: 11px; }

/* Raised buttons: lit from above, a darker bottom edge; pressed sinks in. */
QPushButton {
    background: @raised@;
    border: 1px solid @line@;
    border-bottom-color: @edgeLo@;
    border-radius: @radius@px;
    padding: @padV@px 16px;
    min-width: 64px;
    color: @text@;
}
QPushButton:hover { background: @hover@; border-color: @ring@; }
QPushButton:pressed { background: @well@; border-top-color: @edgeLo@; border-bottom-color: @line@; padding-top: @padV@px; }
QPushButton:default {
    background: @accent@;
    border: 1px solid @accent@;
    color: @onAccent@;
    font-weight: 600;
}
QPushButton:default:hover { background: @accentHover@; border-color: @accentHover@; }
QPushButton:default:pressed { background: @accentBottom@; }
QPushButton:disabled { color: @ring@; }

QCheckBox, QRadioButton { spacing: 8px; }
QCheckBox::indicator, QGroupBox::indicator, QTreeView::indicator, QListView::indicator {
    width: 14px; height: 14px; border: 1.5px solid @ring@; border-radius: 4px; background: @bg@;
}
QCheckBox::indicator:hover, QGroupBox::indicator:hover { border-color: @muted@; }
QCheckBox::indicator:checked, QGroupBox::indicator:checked, QTreeView::indicator:checked, QListView::indicator:checked {
    background: @accent@; border-color: @accent@; image: url(@check@);
}
QCheckBox::indicator:indeterminate, QTreeView::indicator:indeterminate {
    background: @accent@; border-color: @accent@; image: url(@partial@);
}
QCheckBox::indicator:disabled { border-color: @line@; background: @panel@; }
QRadioButton::indicator { width: 14px; height: 14px; border: 1.5px solid @ring@; border-radius: 8px; background: @bg@; }
QRadioButton::indicator:hover { border-color: @muted@; }
QRadioButton::indicator:checked { background: @accent@; border-color: @accent@; image: url(@radioDot@); }

/* Group title above a rounded box, not on its border (DESIGN.md › Settings). */
QGroupBox {
    border: 1px solid @line@;
    border-top-color: @edgeHi@;
    border-radius: 14px;
    margin-top: 32px;
    padding: 14px 14px 12px 14px;
    background: @card@;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    top: 4px;
    padding: 0;
    font-weight: 600;
    color: @text@;
}
QGroupBox::indicator { margin-right: 6px; }

QProgressBar {
    background: @track@;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: @text@;
}
QProgressBar::chunk { background: @accent@; border-radius: 4px; }

QScrollBar:vertical { background: transparent; width: 9px; margin: 0; border: none; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 0; border: none; }
QScrollBar::handle { background: @line@; border-radius: 3px; margin: 2px; }
QScrollBar::handle:vertical { min-height: 28px; }
QScrollBar::handle:horizontal { min-width: 28px; }
QScrollBar::handle:hover { background: @ring@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QSplitter::handle { background: @line@; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QStatusBar {
    background: @bg@;
    border-top: 1px solid @line@;
    color: @muted@;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: @muted@; padding: 0 4px; }
QStatusBar QPushButton, QStatusBar QPushButton:default {
    background: transparent;
    border: none;
    border-radius: @radius@px;
    color: @muted@;
    font-weight: 400;
    padding: 2px 8px;
}
QStatusBar QPushButton:hover { background: @hover@; color: @text@; }
QStatusBar QFrame[frameShape="5"] { color: @line@; background: @line@; max-width: 1px; border: none; margin: 4px 2px; }

/* Flat buttons (the details pane's tab row, filters): text, not chips. */
QPushButton:flat, QPushButton[flat="true"] { background: transparent; border: none; color: @muted@; }
QPushButton:flat:hover { background: @hover@; color: @text@; }
QPushButton:flat:checked, QPushButton:flat:pressed { background: @select@; color: @text@; }

QToolTip { background: @raised@; color: @text@; border: 1px solid @line@; padding: 6px 10px; border-radius: 9px; }

/* Details tabs (General … Speed): an accent underline under the current one. */
QPushButton[doseTab="true"], QPushButton[doseTab="true"]:flat {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    padding: 8px 10px 6px 10px;
    color: @muted@;
}
QPushButton[doseTab="true"]:hover { color: @text@; background: transparent; }
QPushButton[doseTab="true"]:pressed, QPushButton[doseTab="true"]:checked {
    color: @text@;
    background: transparent;
    border-bottom: 2px solid @accent@;
}

/* Primary toolbar button: Add torrent (DESIGN.md › Toolbar). */
QToolButton#dosePrimary {
    background: @accent@;
    color: @onAccent@;
    font-weight: 600;
    border: 1px solid @accent@;
    padding: 3px 14px 3px 10px;
    margin-right: 6px;
}
QToolButton#dosePrimary:hover { background: @accentHover@; border-color: @accentHover@; }
QToolButton#dosePrimary:pressed { background: @accentBottom@; }

/* Status bar: short dividers, items as quiet buttons. */
QStatusBar QFrame[frameShape="5"] { max-height: 14px; min-height: 14px; }
QStatusBar QPushButton { text-align: left; }

/* Content tab: Select all / none as text buttons. */
QPushButton#selectAllButton, QPushButton#selectNoneButton, QPushButton#buttonSelectAll, QPushButton#buttonSelectNone {
    background: transparent; border: none; color: @muted@; padding: 4px 10px; min-width: 0; font-weight: 500;
}
QPushButton#selectAllButton:hover, QPushButton#selectNoneButton:hover, QPushButton#buttonSelectAll:hover, QPushButton#buttonSelectNone:hover { background: @hover@; color: @text@; }

/* Filter sidebar (DESIGN.md › Sidebar): panel colour, sentence-case headings,
   rounded selection, no row dividers. */
TransferListFiltersWidget, TransferListFiltersWidget QScrollArea, TransferListFiltersWidget QScrollArea > QWidget > QWidget { background: @panel@; }
QCheckBox#doseSideHeading { color: @faint@; font-size: @fontSmall@px; padding: 10px 10px 2px 10px; spacing: 6px; }
QCheckBox#doseSideHeading::indicator { width: 10px; height: 10px; border: none; background: transparent; image: url(@chevronDown@); }
QCheckBox#doseSideHeading::indicator:unchecked { image: url(@chevronRight@); }
QAbstractItemView#doseSideList { background: @panel@; border: none; outline: 0; }
QAbstractItemView#doseSideList::item { border: none; border-radius: 9px; padding: @rowPad@px 8px; margin: 0 6px; color: @muted@; }
QAbstractItemView#doseSideList::item:hover { background: @hover@; color: @text@; }
QAbstractItemView#doseSideList::item:selected { background: @select@; color: @text@; }

QStatusBar QPushButton#doseDown { color: @accent@; }
QStatusBar QPushButton#doseUp { color: @ok@; }

*[doseNumber="true"] { font-family: "DM Mono", "Cascadia Mono", monospace; font-size: @fontSmall@px; }

/* Editors inside tables (Advanced settings): no extra padding, so the value
   is never sliced by the row height. */
QTableView QComboBox, QTableView QSpinBox, QTableView QDoubleSpinBox, QTableView QLineEdit {
    padding: 0 8px; border-radius: 6px; min-height: 0; margin: 2px 0;
}
QTableView QComboBox { padding-right: 26px; }

QGroupBox[flat="true"] { background: transparent; border: none; }

/* Nested group boxes: one card is enough. Inner groups lose their frame and
   are indented instead, so borders never stack (DESIGN.md › Settings). */
QGroupBox QGroupBox { border: none; background: transparent; margin-top: 24px; padding: 4px 0 0 18px; }
QGroupBox QGroupBox::title { left: 0; top: 0; color: @muted@; }

/* Small icon buttons beside lists (tracker tier up/down). */
QPushButton#trackerUpButton, QPushButton#trackerDownButton {
    min-width: 0; padding: 4px; margin: 2px 4px;
}

QPushButton[doseTab="true"][doseCollapsed="true"] { color: @text@; border-bottom: 2px solid @ring@; }

/* The filter field in the title bar: one rounded well, icon button inside. */
QFrame#doseSearchField { background: @well@; border: 1px solid @line@; border-top-color: @wellEdge@; border-radius: 8px; }
QFrame#doseSearchField:hover { border-color: @ring@; }
QFrame#doseSearchField QLineEdit, QFrame#doseSearchField QLineEdit:hover, QFrame#doseSearchField QLineEdit:focus {
    background: transparent; border: none; padding: 0 4px; min-height: 0;
}
QToolButton#doseSearchIcon { border: none; border-radius: 6px; padding: 0; background: transparent; }
QToolButton#doseSearchIcon:hover { background: @hover@; }
